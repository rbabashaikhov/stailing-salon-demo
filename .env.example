# Порт приложения (контейнер слушает его; Caddy проксирует на этот порт)
PORT=8080

NODE_ENV=production

# Демо-режим: заявки не создают реальную запись, CRM не вызывается
DEMO_MODE=true

# Собирается в клиент. На preview всегда true.
VITE_DEMO_MODE=true

# Пустой = относительный /api (один контейнер за Caddy)
VITE_API_URL=

# Preview-хост (документация; canonical на demo-домен не ставится)
PUBLIC_HOST=stailing-demo.apps.leadmeter.ru

# Свободный порт на VPS (не конфликтовать с другими контейнерами)
HOST_PORT=8093

# Путь к SQLite с демо-заявками
SQLITE_PATH=./data/demo-bookings.sqlite

# Позже: demo | yclients | dikidi | altegio | custom
CRM_PROVIDER=demo
